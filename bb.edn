{:paths ["src" "resources" "test"]
 :tasks {rebuild-test-app  {:doc  "Install local donut libs, refresh the donut CLI, and rebuild template-test so changes across repos can be tested together"
                            :task donut.project-management.rebuild-test-app/-main}
         regenerate-legacy {:doc  "Older template-test regeneration flow (npm i, git init, entity scaffold), superseded by rebuild-test-app"
                            :task donut.project-management.regenerate-legacy/-main}
         sync-repos        {:doc  "Rebase every sibling donut repo off its GitHub remote and print a report"
                            :task donut.project-management.sync-repos/-main}
         test              {:doc  "Run unit tests"
                            :task test-runner/-main}}
 :deps  {org.clojure/clojure          {:mvn/version "1.12.4"}
         io.github.lispyclouds/bblgum {:git/sha "881a426d9df9df40eb305ceaeb3996ea1c7ae0d3"}
         party.donut/bb-utils         {:local/root "../bb-utils"}
         rewrite-clj/rewrite-clj      {:mvn/version "1.2.54"}}}
